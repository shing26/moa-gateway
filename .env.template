# MoA Gateway 环境变量模板
# 复制为 .env 文件并填写真实值
# .env 已在 .gitignore 中，不会提交到仓库

# LLM Provider (必填)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# Redis (可选, 默认 localhost:6379)
REDIS_URL=redis://localhost:6379/0
# 主 Redis 不可用时是否回退 (1/true 开启, 默认开启)
REDIS_ENABLE_FALLBACK=true

# Redis Sentinel (可选, 生产环境用)
# REDIS_SENTINEL_HOSTS=host1:26379,host2:26379,host3:26379
# REDIS_SENTINEL_MASTER=mymaster

# Webhook / Dashboard 鉴权
# 留空则对应鉴权不启用 (fail-open)；生产环境必须配置
WEBHOOK_AUTH_TOKEN=
DASHBOARD_PASSWORD=

# Feishu (可选, HITL 审批卡片用)
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx

# Feishu 事件验签 (可选; 从飞书开放平台事件订阅页复制; 留空则验签关闭 fail-open)
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# 路由与微模型超时 (毫秒)
ROUTER_LLM_TIMEOUT_MS=2000
MICRO_LLM_TIMEOUT_MS=1000
# 可选：微模型 / 路由 LLM（无 API Key 时保持纯正则降级；未单独配置路由模型时复用主 LLM）
# MICRO_LLM_MODEL=
# MICRO_LLM_API_KEY=
# MICRO_LLM_BASE_URL=
# ROUTER_LLM_MODEL=
# ROUTER_LLM_API_KEY=
# ROUTER_LLM_BASE_URL=

# 人工审批 HITL (可选, 1/true 开启, 默认关闭)
HITL_ENABLED=false

# 环境
MOA_ENV=dev
ENV=dev
# Audit log (optional, default ./logs/)
LOG_DIR=./logs/
LOG_RETENTION_DAYS=90

# Elasticsearch audit (optional, comma-separated hosts; empty disables ES channel)
ES_HOSTS=
ES_INDEX_PREFIX=moa-audit

# Obsidian Vault sync (optional; empty disables)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SYNC_FOLDER=

# OmniRoute AI Gateway (optional, for multi-provider routing)
# Start: docker compose --profile base up -d
# Then set these to point at OmniRoute instead of direct provider:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:20128/v1
# LLM_MODEL=high-availability
OMNIROUTE_API_KEY=

# Code Review Pipeline LLM routing
CODE_REVIEW_PROVIDER=openrouter
CODE_REVIEW_API_KEY=sk-or-v1-xxxxx
CODE_REVIEW_BASE_URL=https://openrouter.ai/api/v1
CODE_REVIEW_MODEL=openrouter/auto
CODE_REVIEW_TIMEOUT=120
CODE_REVIEW_MAX_TOKENS=4096
CODE_REVIEW_TEMPERATURE=0.2

# Provider options: direct | openrouter | omniroute | local
# - direct: use CODE_REVIEW_BASE_URL as-is
# - openrouter: auto-prefix model with openrouter/, default base https://openrouter.ai/api/v1
# - omniroute: route through OmniRoute gateway, default base http://localhost:20128/v1
# - local: local SLM like Ollama, default base http://localhost:11434/v1

# Optional local fallback SLM (used when primary provider fails)
CODE_REVIEW_FALLBACK_PROVIDER=local
CODE_REVIEW_FALLBACK_API_KEY=
CODE_REVIEW_FALLBACK_BASE_URL=http://localhost:11434/v1
CODE_REVIEW_FALLBACK_MODEL=qwen2.5-coder:7b
CODE_REVIEW_FALLBACK_TIMEOUT=180
CODE_REVIEW_FALLBACK_MAX_TOKENS=4096
CODE_REVIEW_FALLBACK_TEMPERATURE=0.2

# ── RAG / Historical PR Ingestion ──────────────────────────────────────
# GitHub API token for fetching historical PRs (required for ingestion)
GITHUB_TOKEN=

# Embedding provider (OpenAI-compatible endpoint)
# Leave empty to disable embeddings / use in-memory vector store only
CODE_REVIEW_EMBEDDING_API_KEY=
CODE_REVIEW_EMBEDDING_BASE_URL=https://api.openai.com/v1
CODE_REVIEW_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL + pgvector DSN for persistent vector storage
# Formats:
#   postgres://USER:***@HOST:PORT/DATABASE
#   postgres://USER:***@HOST:PORT/DATABASE?sslmode=require
# Leave empty to use in-memory vector store (data lost on restart)
CODE_REVIEW_DATABASE_URL=

# SQLite vector store path (used when CODE_REVIEW_DATABASE_URL is empty)
# When set, embeddings are persisted to a local SQLite file instead of memory.
# Example: CODE_REVIEW_VECTOR_DB_PATH=./data/code_review_vectors.sqlite
CODE_REVIEW_VECTOR_DB_PATH=./data/code_review_vectors.sqlite
